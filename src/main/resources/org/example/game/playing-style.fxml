<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: black;" stylesheets="@../../../menu.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.game.PlayingStyleController">

    <center>
        <VBox alignment="CENTER" spacing="40">
            <HBox alignment="CENTER" spacing="50">
                <Button fx:id="mouseButton" styleClass="menu-button">
                    <graphic>
                        <VBox alignment="CENTER" spacing="15">
                            <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@../../../mouse.png" />
                            </ImageView>
                            <Label styleClass="button-label" text="Play with Mouse" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="keyboardButton" styleClass="menu-button">
                    <graphic>
                        <VBox alignment="CENTER" spacing="15">
                            <ImageView fitHeight="202.0" fitWidth="447.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@../../../keyboard.png" />
                            </ImageView>
                            <Label styleClass="button-label" text="Play with Keyboard" />
                        </VBox>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>
